backend/knowledge/employee/*
!backend/knowledge/employee/.gitkeep
!backend/knowledge/employee/sample_policy.txt.example

backend/knowledge/public/*
!backend/knowledge/public/.gitkeep
!backend/knowledge/public/sample_public.txt.example

